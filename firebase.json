{
  "react-native": {
    "analytics_without_ad_id_support": true
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": [
    {
      "bucket": "reelx-backend",
      "rules": "storage.rules"
    },
    {
      "bucket": "reelx-backend.firebasestorage.app",
      "rules": "storage.rules"
    }
  ],
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ]
  }
}
